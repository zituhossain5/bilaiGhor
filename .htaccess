# --- Security: the site root is the project folder, so keep everything but the shop off the web ---
# Only index.php may run. Any other script (an upload, vendor/*.php, router.php, "x.php.jpg") is refused.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh)(\.|$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<FilesMatch "^index\.php$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>
# Application code, logs, dependencies and tooling files are not web pages.
RedirectMatch 404 (?i)^/(app|bootstrap|config|database|docker|lang|node_modules|project|resources|routes|sail|storage|tests|vendor)(/|$)
RedirectMatch 404 (?i)^/(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|vite\.config\.js|[^/]*\.md|\.env.*|\.git.*|\.phpunit.*|\.editorconfig)$
RedirectMatch 404 (?i)(\.(log|sql|sqlite|bak|old|swp)|/error_log)$
# --- end security ---

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # --- Canonical URL: https://bilaighor.bd (one 301 hop from http:// and from www.) ---
    # Only the live hostnames are matched, so local/dev hosts and the server IP are never redirected.
    # TLS is detected both directly (%{HTTPS}) and behind a proxy/CDN (X-Forwarded-Proto).
    # 1) www.bilaighor.bd (http or https) -> https://bilaighor.bd
    RewriteCond %{HTTP_HOST} ^www\.bilaighor\.bd\.?(:[0-9]+)?$ [NC]
    RewriteRule ^ https://bilaighor.bd%{REQUEST_URI} [L,R=301]
    # 2) http://bilaighor.bd -> https://bilaighor.bd
    RewriteCond %{HTTP_HOST} ^bilaighor\.bd\.?(:[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://bilaighor.bd%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# =====================================================================================
# --- Performance: compression and browser caching ---
# Every block sits in an <IfModule> guard: a server without that module skips the block
# instead of failing. These rules also apply to /public/* (public/.htaccess only replaces
# the rewrite rules).
# =====================================================================================

# --- Content types for modern formats, so browsers accept them and compression-by-type
#     below recognises them (older mime.types files may lack these) ---
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType font/otf .otf
</IfModule>

# --- Compression of text responses: Brotli when the server has it (smaller), gzip
#     otherwise. Each encoder only runs when the browser asks for it (Accept-Encoding),
#     and a response that is already compressed (e.g. PHP's zlib.output_compression) is
#     left alone. JPG/PNG/WebP and woff/woff2 are already compressed, so they are not listed. ---
<IfModule mod_filter.c>
    <IfModule mod_brotli.c>
        AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/json application/ld+json application/manifest+json application/xml application/xhtml+xml application/rss+xml image/svg+xml image/x-icon image/vnd.microsoft.icon font/ttf font/otf application/x-font-ttf application/vnd.ms-fontobject
    </IfModule>
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/json application/ld+json application/manifest+json application/xml application/xhtml+xml application/rss+xml image/svg+xml image/x-icon image/vnd.microsoft.icon font/ttf font/otf application/x-font-ttf application/vnd.ms-fontobject
    </IfModule>
</IfModule>

# --- Browser caching of static files: 1 year, immutable (no revalidation requests) ---
# Safe because these URLs change whenever the file changes:
#   * CSS/JS are linked through asset_v(), which adds ?v=<file modification time>;
#   * uploads get a timestamped name, and their .webp copies follow the original.
# A theme image replaced under the SAME name would stay cached: give it a new name instead.
# Matched by file extension on real files only, so HTML pages and Laravel routes (including
# /style.css and /responsive.css) keep the headers Laravel sends: no long cache for HTML.
<IfModule mod_expires.c>
    <FilesMatch "(?i)\.(css|js|mjs|woff2?|ttf|otf|eot|webp|avif|png|jpe?g|gif|svg|ico)$">
        ExpiresActive On
        ExpiresDefault "access plus 1 year"
    </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "(?i)\.(css|js|mjs|woff2?|ttf|otf|eot|webp|avif|png|jpe?g|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

